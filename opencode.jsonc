{
  // Tested with OpenCode 1.19.6 (npm i -g opencode-ai@1.19.6).
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coder",
  "mcp": {
    "servers": {
      // Stub for now; the context engine's real server takes over this name.
      "context-engine": {
        "type": "local",
        "command": [
          "uv", "run", "--directory", "packages/orchestrator",
          "python", "-m", "orchestrator.stub_mcp"
        ]
      },
      // Runs commands and tests in a container. --project keeps the working
      // directory at the repo root, which the server mounts as /work.
      "sandbox": {
        "type": "local",
        "command": [
          "uv", "run", "--project", "packages/sandbox",
          "python", "-m", "sandbox.server"
        ]
      }
    }
  }
}
